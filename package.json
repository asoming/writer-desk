{
  "name": "writer-desk",
  "version": "0.8.2",
  "private": true,
  "description": "作家工作台 — Writer's Desk. A local-first writing studio.",
  "author": "Writer's Desk contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "build:backend": "node scripts/build-backend.cjs",
    "build:linux": "python3 scripts/build-linux.py",
    "build:win": "node scripts/build-native.cjs --platform win32 --arch x64",
    "build:mac": "node scripts/build-native.cjs --platform darwin",
    "test:desktop": "node scripts/test-desktop.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:deb": "node scripts/build-native.cjs --platform linux --arch x64",
    "test:packaging": "node --test tests/packaging.test.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.writerdesk.app",
    "productName": "Writer's Desk",
    "executableName": "writer-desk",
    "asar": true,
    "afterPack": "desktop/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "!desktop/BUILD.md"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "desktop/assets/icon.png",
      "category": "Office",
      "desktop": {
        "entry": {
          "Name": "作家工作台",
          "Name[en]": "Writer's Desk",
          "Name[zh]": "作家工作台",
          "Name[zh_CN]": "作家工作台",
          "Comment": "本地小说写作与策划工作台",
          "Comment[en]": "Local writing studio",
          "Keywords": "作家工作台;作家;写作;小说;Writer's Desk;writer;desk;writing;novel;",
          "StartupWMClass": "Writer's Desk"
        }
      },
      "artifactName": "WriterDesk-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "WriterDesk-${version}-windows-${arch}.${ext}",
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "作家工作台",
      "uninstallDisplayName": "作家工作台 · Writer's Desk",
      "runAfterFinish": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "WriterDesk-${version}-mac-${arch}.${ext}",
      "icon": "desktop/assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "CFBundleDisplayName": "作家工作台",
        "NSHighResolutionCapable": true,
        "NSSupportsAutomaticGraphicsSwitching": true
      }
    },
    "beforePack": "desktop/before-pack.cjs",
    "forceCodeSigning": false,
    "publish": null,
    "deb": {
      "maintainer": "Writer's Desk contributors <noreply@writerdesk.local>",
      "depends": [
        "libc6 (>= 2.35)",
        "libglib2.0-0 (>= 2.64) | libglib2.0-0t64 (>= 2.64)",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libx11-6",
        "libxext6",
        "libxcb1",
        "libcups2 | libcups2t64",
        "libdbus-1-3",
        "libexpat1",
        "libudev1"
      ]
    },
    "dmg": {
      "title": "Writer's Desk ${version}",
      "icon": "desktop/assets/icon.icns",
      "backgroundColor": "#f4f6fa",
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 150,
          "y": 170,
          "type": "file"
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
